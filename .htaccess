<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0. Canonical: Redirigir www.montec.ar a https://montec.ar/ (301 permanente)
  RewriteCond %{HTTP_HOST} ^www\.montec\.ar$ [NC]
  RewriteRule ^(.*)$ https://montec.ar/$1 [R=301,L,QSA]

  # 1. Si piden / o /index.html explícitamente, servir SIEMPRE dist/index.html compilado
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^index\.html$ dist/index.html [L]

  # 2. Mapear directamente /assets/ hacia dist/assets/
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # 3. Si el archivo solicitado existe dentro de dist/, servirlo desde allí
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 4. Enrutamiento SPA: cualquier otra ruta (ej: ?taller=1, subrutas) servir dist/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule . dist/index.html [L]
</IfModule>
