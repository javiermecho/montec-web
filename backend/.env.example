# Puerto del servidor (Railway inyecta PORT automáticamente)
PORT=5000

# URL de conexión a PostgreSQL (provista por Railway)
# Formato: postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway
DATABASE_URL=postgresql://postgres:password@localhost:5432/montec_db

# Margen base de ganancia y mano de obra para cotización automática
# 1.50 = 50% de margen sobre el costo de repuesto
DEFAULT_MARGIN_MULTIPLIER=1.45
MINIMUM_LABOR_FEE=12000

# Secret o API Key para disparar el scraper de forma remota
SCRAPER_SECRET_KEY=montec_mdp_secret_scrape_2026

# Google Ads API - Credenciales OAuth2 y Developer Token
GOOGLE_ADS_CLIENT_ID=tu_google_ads_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=tu_google_ads_client_secret
GOOGLE_ADS_REFRESH_TOKEN=tu_refresh_token
GOOGLE_ADS_CUSTOMER_ID=18464752657
GOOGLE_ADS_DEVELOPER_TOKEN=tu_developer_token
